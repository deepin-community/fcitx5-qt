diff --git a/qt6/CMakeLists.txt b/qt6/CMakeLists.txt
index bff3a03..ef0993a 100644
--- a/qt6/CMakeLists.txt
+++ b/qt6/CMakeLists.txt
@@ -1,8 +1,18 @@
 
 find_package(Qt6 ${REQUIRED_QT6_VERSION} CONFIG REQUIRED Core DBus Widgets)
 find_package(Qt6Gui ${REQUIRED_QT6_VERSION} REQUIRED Private)
+# Since Qt 6.10 private module targets ship as standalone CMake packages
+# (e.g. Qt6GuiPrivate) and are no longer auto-created by the module's
+# Qt6GuiTargets.cmake, so fetch them explicitly when the old-style
+# <Module> REQUIRED Private lookup did not create the target.
+if (NOT TARGET Qt6::GuiPrivate)
+  find_package(Qt6GuiPrivate ${REQUIRED_QT6_VERSION} CONFIG REQUIRED)
+endif()
 if (ENABLE_QT6_WAYLAND_WORKAROUND)
   find_package(Qt6WaylandClient ${REQUIRED_QT6_VERSION} REQUIRED Private)
+  if (NOT TARGET Qt6::WaylandClientPrivate)
+    find_package(Qt6WaylandClientPrivate ${REQUIRED_QT6_VERSION} CONFIG REQUIRED)
+  endif()
   find_package(Qt6WaylandGlobalPrivate ${REQUIRED_QT6_VERSION} REQUIRED)
 endif()
 
